# ticket-service — Environment Variables
# Salin file ini ke .env dan isi nilainya sebelum menjalankan service

# Server
PORT=3002

# PostgreSQL — ticket_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ticket_db
DB_USER=kelompok5
DB_PASSWORD=

# Redis — distributed lock
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_URL=amqp://kelompok5:<password>@localhost:5672

# URL service lain (gunakan nama container di Docker)
EVENT_SERVICE_URL=http://localhost:3001

# Durasi lock kursi dalam menit (default: 15)
LOCK_TTL_MINUTES=15
