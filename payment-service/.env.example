# payment-service — Environment Variables
# Salin file ini ke .env dan isi nilainya sebelum menjalankan service

# Server
PORT=3003

# PostgreSQL — payment_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=payment_db
DB_USER=kelompok5
DB_PASSWORD=

# RabbitMQ
RABBITMQ_URL=amqp://kelompok5:<password>@localhost:5672

# URL service lain (gunakan nama container di Docker)
TICKET_SERVICE_URL=http://localhost:3002

# Timeout pembayaran dalam menit (default: 15)
# Catatan: saat ini belum digunakan — lock TTL diambil dari ticket-service
PAYMENT_TIMEOUT_MINUTES=15
